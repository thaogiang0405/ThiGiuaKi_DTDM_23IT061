<h2>Thêm Sách Mới</h2>
<form action="/add-book" method="POST">
    <input type="text" name="code" placeholder="Mã sách (Bắt đầu bằng 061)" required>
    <input type="text" name="name" placeholder="Tên sách" required>
    <input type="number" name="price" placeholder="Giá tiền gốc" required>
    <button type="submit">Thêm Sách</button>
</form>

<h2>Danh sách Sách</h2>
<ul>
    {{#each books}}
        <li>[{{this.code}}] {{this.name}} - Giá sau thuế: {{this.priceAfterTax}}</li>
    {{/each}}
</ul>
<hr>
<!-- Footer bắt buộc chứa thông tin cá nhân[cite: 10] -->
<footer>
    <p>Họ tên: {{hoTen}} | MSSV: {{mssv}} | Mức VAT áp dụng: {{vat}}%</p>
</footer>